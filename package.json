{
  "name": "ice-club-menu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "db:local": "wrangler d1 migrations apply ice-club-db --local",
